#!/bin/bash
set -euo pipefail

# Prefer a machine-local Flutter install (analyze / pub / test only on
# headless clones). Override with FLUTTER_ROOT if needed.
if [[ -n "${FLUTTER_ROOT:-}" && -x "${FLUTTER_ROOT}/bin/flutter" ]]; then
  exec "${FLUTTER_ROOT}/bin/flutter" "$@"
fi
if [[ -x "$HOME/flutter/bin/flutter" ]]; then
  exec "$HOME/flutter/bin/flutter" "$@"
fi

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
if [[ -x "$DIR/vendor/flutter/bin/flutter" ]]; then
  export PATH="$DIR/vendor/flutter/bin:$PATH"
  exec flutter "$@"
fi

# Fall back to whatever Flutter the machine has on PATH (e.g. a dotfiles
# or version-manager install). The project's current Flutter version is
# tracked in docs/upgrade-plan.md — repo-level SDK pinning was dropped
# (the old .flutter submodule pinned 3.13.9, years below the project's
# minimum, and this wrapper never used it).
if command -v flutter >/dev/null 2>&1; then
  exec flutter "$@"
fi

echo "flutterw: no Flutter SDK found (set FLUTTER_ROOT, install to ~/flutter, or put flutter on PATH)" >&2
exit 1

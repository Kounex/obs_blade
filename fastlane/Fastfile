# Store lanes for OBS Blade. Run them through tool/release (see its README):
# it runs the preflight checks, prints what a lane would do and only calls it
# with --yes. Calling a lane directly skips all of that. The App Review
# submission is not a lane: tool/release does it through the ASC API.
#
# Credentials are read by path from the environment and never stored here:
#   OBS_BLADE_ASC_KEY_PATH, OBS_BLADE_ASC_KEY_ID, OBS_BLADE_ASC_ISSUER_ID
#   OBS_BLADE_GOOGLE_APPLICATION_CREDENTIALS

opt_out_usage
default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("OBS_BLADE_ASC_KEY_ID"),
    issuer_id: ENV.fetch("OBS_BLADE_ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("OBS_BLADE_ASC_KEY_PATH"),
  )
end

def play_json_key
  ENV.fetch("OBS_BLADE_GOOGLE_APPLICATION_CREDENTIALS")
end

# Play: every lane but the uploads skips the listing parts explicitly.
PLAY_SKIP_LISTING = {
  skip_upload_metadata: true,
  skip_upload_changelogs: true,
  skip_upload_images: true,
  skip_upload_screenshots: true,
}.freeze

platform :ios do
  desc "Upload an .ipa to TestFlight (internal testers only)"
  lane :beta do |options|
    pilot(
      api_key: asc_api_key,
      ipa: options.fetch(:ipa),
      changelog: File.read("metadata/ios/en-US/release_notes.txt"),
      distribute_external: false,
      skip_waiting_for_build_processing: false,
    )
  end

  desc "Push listing text + screenshots to the version being prepared"
  lane :metadata do |options|
    deliver(
      api_key: asc_api_key,
      app_version: options.fetch(:version),
      skip_binary_upload: true,
      metadata_path: "./fastlane/metadata/ios",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true, # no HTML preview - tool/release shows the plan instead
    )
  end
end

platform :android do
  desc "Upload an .aab to the internal testing track"
  lane :beta do |options|
    upload_to_play_store(
      json_key: play_json_key,
      track: "internal",
      aab: options.fetch(:aab),
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      # what's new from metadata/android/en-US/changelogs/default.txt
      skip_upload_changelogs: false,
    )
  end

  desc "Push listing text, feature graphic and screenshots"
  lane :metadata do
    upload_to_play_store(
      json_key: play_json_key,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      metadata_path: "./fastlane/metadata/android",
    )
  end

  desc "Promote an internal release to production"
  lane :promote do |options|
    upload_to_play_store(
      json_key: play_json_key,
      track: "internal",
      track_promote_to: "production",
      version_code: options.fetch(:version_code).to_i,
      rollout: options.fetch(:rollout, "1").to_s,
      skip_upload_apk: true,
      skip_upload_aab: true,
      **PLAY_SKIP_LISTING,
    )
  end

  desc "Halt the production rollout of a release"
  lane :halt do |options|
    upload_to_play_store(
      json_key: play_json_key,
      track: "production",
      version_code: options.fetch(:version_code).to_i,
      release_status: "halted",
      skip_upload_apk: true,
      skip_upload_aab: true,
      **PLAY_SKIP_LISTING,
    )
  end
end

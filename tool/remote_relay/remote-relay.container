[Unit]
Description=OBS Blade remote relay (Pro: reach OBS from anywhere)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/kounex/remote-relay:0.0.9
ContainerName=remote-relay
Network=host
# RC_PROJECT_ID, RC_API_KEY (RevenueCat v2 secret key, read-only customer
# information + project configuration), optional RC_PRO_ENTITLEMENT_ID and
# RELAY_PRO_ALLOW (comma-separated app user ids, maintainers' dogfooding).
EnvironmentFile=/etc/remote-relay.env
Volume=/var/lib/remote-relay:/var/lib/remote-relay:Z
Exec=python3 /app/relay.py

# /health every 30 s; three misses in a row (90 s unresponsive) kill the
# container and Restart=on-failure starts it again. The fleet board's
# updater also waits for "healthy" before it keeps a new image. busybox
# wget (Alpine base): no nested quotes for Quadlet to mangle.
HealthCmd=wget -q -T 4 -O /dev/null http://127.0.0.1:8426/health
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
HealthOnFailure=kill

[Service]
Restart=on-failure
# Its own caps, so a traffic spike can't stall the Kick relays next to it.
MemoryMax=384M
CPUQuota=100%
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target

[Unit]
Description=Kick events relay (OBS Blade activity feed)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/kounex/kick-events:1.0.5
ContainerName=kick-events
Network=host
# Same Kick app as kick-auth: client credentials for the app token.
EnvironmentFile=/etc/kick-auth.env
Volume=/var/lib/kick-events:/var/lib/kick-events:Z
Exec=python3 /app/relay.py

# /health every 30 s; three misses in a row (90 s unresponsive) kill the
# container and Restart=on-failure starts it again. The fleet board's
# updater also waits for "healthy" before it keeps a new image. busybox
# wget (Alpine base): no nested quotes for Quadlet to mangle.
HealthCmd=wget -q -T 4 -O /dev/null http://127.0.0.1:8423/health
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
HealthOnFailure=kill

[Service]
Restart=on-failure
MemoryMax=192M
CPUQuota=50%
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target

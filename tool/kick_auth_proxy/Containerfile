FROM python:3.15.0-alpine3.24@sha256:2699b90f4d562a22e2dd076c82f964032f64814204bff36d271a54ba4cc2c7e2

RUN apk add --no-cache curl \
    && adduser -D -H -u 65532 exchanger

WORKDIR /app
COPY proxy.py .

USER 65532:65532
EXPOSE 8422

# Listen address is overridden by the quadlet so the host loopback is used
# (Network=host). The default stays loopback if the image is run alone.
ENV KICK_AUTH_LISTEN=127.0.0.1
ENV KICK_AUTH_PORT=8422

CMD ["python3", "/app/proxy.py"]
